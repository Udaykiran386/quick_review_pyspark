   "source": [
    "spark.conf.set(\"spark.sql.shuffle.partitions\",4)\n",
    "\n",
    "wide1=(\n",
    "    df.where(F.col(\"release_year\")>=2010)\n",
    "        .repartition(4)\n",
    "        .groupBy(\"studio\")\n",
    "        .agg(F.round(F.avg(F.col(\"revenue\").cast(\"double\")),2).alias(\"avg_revenue\"))\n",
    ")\n",
    "wide1.explain(\"formatted\")"
   ]
  }
